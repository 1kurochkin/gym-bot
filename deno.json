{
  "compilerOptions": {
    "strict": true,
    "noUncheckedIndexedAccess": true
  },
  "imports": {
    "grammy": "npm:grammy@^1.46.0",
    "zod": "npm:zod@^4.6.5",
    "drizzle-orm": "npm:drizzle-orm@^0.45.3",
    "drizzle-orm/": "npm:/drizzle-orm@^0.45.3/",
    "drizzle-kit": "npm:drizzle-kit@^0.31.11",
    "postgres": "npm:postgres@^3.4.9",
    "@std/assert": "jsr:@std/assert@^1",
    "@std/fs": "jsr:@std/fs@^1",
    "@std/path": "jsr:@std/path@^1",
    "@photostructure/tz-lookup": "npm:@photostructure/tz-lookup@^11.7.0"
  },
  "tasks": {
    "dev": "deno run --allow-net --allow-env --allow-read --env-file=.env src/app/dev.ts",
    "check": "deno fmt --check && deno lint && deno check src/ supabase/functions/ tests/ && deno test --allow-read --allow-env",
    "test": "deno test --allow-read --allow-env",
    "deploy": "supabase functions deploy bot --no-verify-jwt",
    "db:generate": "deno run -A npm:drizzle-kit@^0.31.11 generate",
    "webhook:set": "deno run --allow-net --allow-env --env-file=.env.prod src/app/set-webhook.ts"
  },
  "fmt": {
    "lineWidth": 100,
    "singleQuote": true,
    "exclude": [
      ".specs/",
      "docs/",
      "CLAUDE.md",
      "STATUS.md",
      "supabase/migrations/",
      "supabase/.temp/"
    ]
  },
  "lint": {
    "rules": {
      "include": [
        "no-explicit-any",
        "eqeqeq",
        "explicit-function-return-type"
      ]
    },
    "exclude": [
      "supabase/.temp/"
    ]
  },
  "nodeModulesDir": "auto"
}
