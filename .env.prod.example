# Прод: скопируй в .env.prod (он в .gitignore) и заполни. Инструкция — README → Деплой.
# Проще всего деплоить скиллом /deploy в Claude Code: он сам заполнит WEBHOOK_SECRET, CRON_SECRET, BOT_INFO.

# Токен боевого бота (не dev).
BOT_TOKEN=
# Telegram user id владельцев через запятую; остальных владелец приглашает в боте (/invite).
ALLOWED_USER_IDS=
# Dashboard → Connect → Transaction pooler (порт 6543), с паролем БД.
DATABASE_URL=
# openssl rand -hex 32
WEBHOOK_SECRET=
# openssl rand -hex 32
CRON_SECRET=
# Dashboard → Connect → Session pooler (порт 5432). Только для миграций (supabase db push), в функцию не загружается.
MIGRATION_DB_URL=
# Необязательно: curl https://api.telegram.org/bot<BOT_TOKEN>/getMe | jq -c .result
BOT_INFO=
# https://<ref>.supabase.co/functions/v1/bot — нужен webhook:set и /deploy; в функцию не загружается.
FUNCTION_URL=
# Регион проекта (us-east-2 и т. п.): webhook запускает функцию рядом с БД. prod.sh fill заполнит сам.
FUNCTION_REGION=
# Необязательно: LLM для «Программы из текста» (бесплатные тарифы). Без LLM_API_KEY кнопка скрыта.
# Ключ Groq: console.groq.com → API Keys.
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_MODEL=openai/gpt-oss-120b
LLM_API_KEY=
# Запасной провайдер — ключ Google AI Studio: aistudio.google.com → Get API key.
LLM_FALLBACK_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
LLM_FALLBACK_MODEL=gemini-flash-latest
LLM_FALLBACK_API_KEY=
# Разборов за 24 часа у участника (у владельца без лимита); по умолчанию 10.
LLM_DAILY_LIMIT=
