# Локальная разработка: скопируй в .env (он в .gitignore).
# Для dev лучше отдельный бот от @BotFather: long polling и webhook на одном токене конфликтуют.
BOT_TOKEN=
# Telegram user id владельцев через запятую; остальных владелец приглашает в боте (/invite).
ALLOWED_USER_IDS=
# Локальный Supabase (supabase start). В проде — строка пулера Supavisor, порт 6543.
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres
# Только для прода (webhook и /health); в dev не нужны.
WEBHOOK_SECRET=
CRON_SECRET=
# Необязательно: ответ getMe одной строкой JSON. Тогда grammY не вызывает getMe на холодном старте.
# Получить: curl https://api.telegram.org/bot$BOT_TOKEN/getMe | jq -c .result
BOT_INFO=
# Необязательно: LLM для «Программы из текста» (бесплатные тарифы). Без LLM_API_KEY кнопка скрыта.
# Ключ Groq: console.groq.com → API Keys.
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_MODEL=openai/gpt-oss-120b
LLM_API_KEY=
# Запасной провайдер — ключ Google AI Studio: aistudio.google.com → Get API key.
LLM_FALLBACK_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
LLM_FALLBACK_MODEL=gemini-flash-latest
LLM_FALLBACK_API_KEY=
# Разборов за 24 часа у участника (у владельца без лимита); по умолчанию 10.
LLM_DAILY_LIMIT=
